# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY has full read/write access and bypasses Row Level
# Security — keep it server-side only, never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Basic Auth credentials protecting /admin (the submissions dashboard).
# Choose your own values — these are not defaults, the app refuses all
# /admin access until both are set.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
