# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY has full read/write access and bypasses Row Level
# Security — keep it server-side only, never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The anon/public key — required for broker auth (signup/login/dashboard at
# /broker/*). Safe to use server-side even though it's the "public" key;
# kept out of the browser bundle here since all auth goes through our own
# API routes rather than a browser-side Supabase client.
SUPABASE_ANON_KEY=your-anon-key

# Basic Auth credentials protecting /admin (the submissions dashboard).
# Choose your own values — these are not defaults, the app refuses all
# /admin access until both are set.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
